# secrets — never baked into the image, passed at runtime via --env-file
.env
.env.example

# runtime state — the vector index and conversation memory are volume mounts,
# not image contents (see the docker run command for the mount points)
.chroma/
checkpoint.db*

# dead weight — venv lives inside the repo; these aren't needed at build time.
# data/ is NOT excluded: scripts/fetch_corpus.py downloads the papers into it
# during the build (see Dockerfile), so the image ships with the corpus baked
# in rather than fetching it on every container start.
agentic-rag/
eval/
notebooks/

view_graph.py
graph.png
question.json
output documentation/

# vcs / editor / python noise
.git/
.gitignore
.vscode/
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store
CLAUDE.md
