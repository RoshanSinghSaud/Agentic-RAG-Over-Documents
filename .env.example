# Copy this file to `.env` and fill in your key(s).
#
# Every value below is read by src/config.py. Anything commented out falls back
# to the default shown, which is what the project has always used — so locally
# you only need OPENAI_API_KEY.
#
# In a container there is no .env file: the platform (Railway, Render, EC2's
# `docker run -e ...`) sets these as real environment variables instead.

# --- Required. The app refuses to start without this. ---
OPENAI_API_KEY=sk-...

# --- Required. Gates /ask and /resume (X-API-Key header); /health and /ready
# --- stay open so a platform health check can reach them without a key. ---
API_KEY=changeme

# --- Optional. Web search degrades without it; the app still serves. ---
# TAVILY_API_KEY=tvly-...

# --- Set by the host, not by you ---
# The platform tells the app which port to listen on. Defaults to 8000.
# PORT=8000

# --- Models ---
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# --- Paths. These are what actually differ between your laptop, a container
# --- and an EC2 box with an attached disk. Defaults are relative to the repo.
# DATA_DIR=./data
# CHROMA_DIR=./.chroma
# CHECKPOINT_DB=./checkpoint.db
# COLLECTION_NAME=agentic_rag

# --- Chunking ---
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150

# --- Retrieval ---
# DENSE_K=8        # candidates pulled from the vector store
# SPARSE_K=8       # candidates pulled from BM25
# RRF_K=60         # Reciprocal Rank Fusion constant
# TOP_K=6          # final chunks handed to the generator

# --- Layer 2: CRAG (corrective retrieval) ---
# MIN_RELEVANT_DOCS=2      # fewer surviving chunks than this => retrieval is "weak"
# MAX_RETRIEVAL_LOOPS=2    # transform_query -> retrieve cycles before web fallback
# WEB_SEARCH_K=3           # Tavily results appended on web fallback

# --- Layer 3: Self-RAG (answer self-correction) ---
# MAX_GENERATION_LOOPS=2   # regenerations before returning the best-effort answer

# --- Not wired up (see CLAUDE.md "Known limitations") ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=agentic-rag
